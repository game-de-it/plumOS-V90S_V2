#!/bin/sh
set -u

PLUMOS_ROOT="${PLUMOS_ROOT:-/mnt/plumos}"
PLUMOS_SDCARD_ROOT="${PLUMOS_SDCARD_ROOT:-$PLUMOS_ROOT}"
USERDATA_ROOT="${PLUMOS_USERDATA_ROOT:-/mnt/plumos-user}"
RUNTIME_ROOT="${PLUMOS_RUNTIME_ROOT:-/run/plumos}"
PATH="${PLUMOS_ROOT}/bin:${PLUMOS_ROOT}/gnu/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH PLUMOS_ROOT PLUMOS_SDCARD_ROOT

STATE_DIR="${PLUMOS_USB_DISK_STATE_DIR:-${PLUMOS_ROOT}/state/usb-disk}"
RUN_DIR="${PLUMOS_USB_DISK_RUN_DIR:-${RUNTIME_ROOT}/usb-disk}"
LOG_DIR="${PLUMOS_ROOT}/Logs"
LOG_FILE="${LOG_DIR}/usb-disk-mode.log"
MOUNT_DIR="${PLUMOS_USB_DISK_MOUNT:-${USERDATA_ROOT}}"
EXPORT_DEVICE_OVERRIDE="${PLUMOS_USB_DISK_DEVICE:-}"
EXPORT_DEVICE=""
CONNECT_TIMEOUT_SECONDS="${PLUMOS_USB_DISK_CONNECT_TIMEOUT_SECONDS:-45}"
COMMAND_TIMEOUT_SECONDS="${PLUMOS_USB_COMMAND_TIMEOUT_SECONDS:-120}"
FSCK_TIMEOUT_SECONDS="${PLUMOS_USB_FSCK_TIMEOUT_SECONDS:-30}"
COMMAND_DIR_NAME="${PLUMOS_USB_COMMAND_DIR_NAME:-commands}"
RESULTS_DIR_NAME="${PLUMOS_USB_RESULTS_DIR_NAME:-results}"
PROCESSED_DIR_NAME="${PLUMOS_USB_PROCESSED_DIR_NAME:-processed}"
GADGET_NAME="${PLUMOS_USB_DISK_GADGET_NAME:-plumos_usb_disk}"
GADGET_DIR="/sys/kernel/config/usb_gadget/${GADGET_NAME}"
FUNCTION_NAME="mass_storage.usb0"
ADB_CONTROL="${PLUMOS_ROOT}/bin/plumos-adbd"
NETWORK_SERVICES="${PLUMOS_ROOT}/bin/plumos-network-services"
SERVICES_CONF="${PLUMOS_ROOT}/config/network/services.conf"
SERVICES_BACKUP="${RUN_DIR}/services.conf.before-usb"
SERVICES_RESTORE_FILE="${RUN_DIR}/restore-network-services"
ADB_RESTORE_FILE="${RUN_DIR}/restore-adb"
SD2_CONTROL="${PLUMOS_ROOT}/bin/plumos-sd2-content-mount"
BOOTSTRAP_CONTROL="${PLUMOS_USB_BOOTSTRAP_CONTROL:-/usr/sbin/plumos-app-layer-bootstrap}"
ACTIVE=0
ADB_RESTORE=0
SERVICES_RESTORE=0
USERDATA_RELEASED=0

mkdir -p "$STATE_DIR" "$RUN_DIR" "$LOG_DIR" 2>/dev/null || true

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || true)" "$*" >> "$LOG_FILE" 2>/dev/null || true
}

cleanup_on_signal() {
  if [ "$ACTIVE" -eq 1 ]; then
    log "signal_cleanup"
    teardown_gadget
  fi
  [ "$USERDATA_RELEASED" -eq 0 ] || mount_userdata || true
  restore_network_services
  restore_adb
  exit 130
}

trap cleanup_on_signal INT TERM HUP

usage() {
  cat <<'USAGE'
Usage: plumos-usb-disk-mode COMMAND

Commands:
  enter     Unmount and export SD1 p4 PLUMOS as a USB drive.
  leave     Unexport, check, and remount p4 on V90S.
  mount     Check and mount p4 on V90S without exporting it.
  unmount   Unmount p4 from V90S after releasing content bindings.
  process-commands
            Execute an armed commands/run.sh from p4.
  status    Print USB disk mode state.

The exported disk is SD1 p4 PLUMOS itself. plumOS releases every p4 bind mount
and unmounts p4 before binding it to USB, then checks and remounts it after host
eject and disconnect. The PC and V90S never mount p4 concurrently.

USB command mailbox:
  1. Put a shell script at commands/run.sh on the PLUMOS drive.
  2. Create an empty commands/ALLOW_EXECUTE file.
  3. Eject PLUMOS on the PC and unplug the USB cable.
  4. V90S executes the script after remounting p4.
  5. Read RESULT-LATEST.txt and results/<timestamp>/ on the next USB session.
USAGE
}

is_path_mounted() {
  grep -q " $1 " /proc/mounts 2>/dev/null
}

is_mounted() {
  is_path_mounted "$MOUNT_DIR"
}

mount_source() {
  awk -v target="$1" '$2 == target { print $1; exit }' /proc/mounts 2>/dev/null
}

gadget_bound() {
  [ -r "${GADGET_DIR}/UDC" ] && [ -n "$(cat "${GADGET_DIR}/UDC" 2>/dev/null)" ]
}

udc_name() {
  if [ "${PLUMOS_USB_UDC:-auto}" != auto ]; then
    printf '%s\n' "$PLUMOS_USB_UDC"
    return 0
  fi
  for udc in /sys/class/udc/*; do
    [ -e "$udc" ] || continue
    basename "$udc"
    return 0
  done
  return 1
}

udc_state() {
  udc="$(udc_name 2>/dev/null || true)"
  if [ -n "$udc" ] && [ -r "/sys/class/udc/${udc}/state" ]; then
    cat "/sys/class/udc/${udc}/state" 2>/dev/null || true
    return 0
  fi
  printf '%s\n' unknown
}

ensure_configfs() {
  if [ ! -d /sys/kernel/config ]; then
    log "configfs_missing"
    return 1
  fi
  if [ ! -d /sys/kernel/config/usb_gadget ]; then
    mount -t configfs none /sys/kernel/config >> "$LOG_FILE" 2>&1 || true
  fi
  [ -d /sys/kernel/config/usb_gadget ]
}

resolve_export_device() {
  if [ -n "$EXPORT_DEVICE" ] && [ -b "$EXPORT_DEVICE" ]; then
    printf '%s\n' "$EXPORT_DEVICE"
    return 0
  fi
  candidate=""
  if [ -n "$EXPORT_DEVICE_OVERRIDE" ]; then
    candidate="$EXPORT_DEVICE_OVERRIDE"
  elif is_mounted; then
    candidate="$(mount_source "$MOUNT_DIR")"
  elif [ -s "${RUN_DIR}/export-device" ]; then
    candidate="$(sed -n '1p' "${RUN_DIR}/export-device")"
  fi
  case "$candidate" in
    /dev/*) ;;
    *) log "export_device_invalid path=${candidate:-missing}"; return 1 ;;
  esac
  [ -b "$candidate" ] || {
    log "export_device_missing path=${candidate}"
    return 1
  }
  probe="$(blkid -c /dev/null "$candidate" 2>/dev/null || blkid "$candidate" 2>/dev/null || true)"
  label="$(printf '%s\n' "$probe" | sed -n 's/.*LABEL="\([^"]*\)".*/\1/p')"
  fstype="$(printf '%s\n' "$probe" | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p')"
  [ "$label" = PLUMOS ] || {
    log "export_device_refused path=${candidate} label=${label:-missing}"
    return 1
  }
  case "$fstype" in vfat|msdos) ;; *)
    log "export_device_refused path=${candidate} fstype=${fstype:-missing}"
    return 1
  esac
  EXPORT_DEVICE="$candidate"
  printf '%s\n' "$EXPORT_DEVICE" > "${RUN_DIR}/export-device"
  printf '%s\n' "$EXPORT_DEVICE"
}

stop_sd2_bindings() {
  if [ -x "$SD2_CONTROL" ]; then
    PLUMOS_ROOT="$PLUMOS_ROOT" PLUMOS_USERDATA_ROOT="$USERDATA_ROOT" \
      "$SD2_CONTROL" stop >> "$LOG_FILE" 2>&1 || true
  fi
}

unmount_content_bindings() {
  for target in \
      "$PLUMOS_ROOT/themes-user" \
      "$PLUMOS_ROOT/Images" \
      "$PLUMOS_ROOT/bios" \
      "$PLUMOS_ROOT/roms"; do
    if is_path_mounted "$target"; then
      umount "$target" >> "$LOG_FILE" 2>&1 || return 1
    fi
  done
}

mount_userdata() {
  resolve_export_device >/dev/null || return 1
  if gadget_bound; then
    log "mount_refused reason=gadget_bound"
    return 1
  fi
  mkdir -p "$MOUNT_DIR"
  if ! is_mounted; then
    command -v fsck.fat >/dev/null 2>&1 || {
      log "userdata_check_failed reason=fsck_fat_missing"
      return 1
    }
    fsck_rc=0
    if command -v timeout >/dev/null 2>&1; then
      timeout "$FSCK_TIMEOUT_SECONDS" fsck.fat -a "$EXPORT_DEVICE" \
        >> "$LOG_FILE" 2>&1 || fsck_rc="$?"
    else
      fsck.fat -a "$EXPORT_DEVICE" >> "$LOG_FILE" 2>&1 || fsck_rc="$?"
    fi
    case "$fsck_rc" in
      0|1) ;;
      *)
        log "userdata_check_failed device=${EXPORT_DEVICE} rc=${fsck_rc}"
        return 1
        ;;
    esac
    mount -t vfat -o rw,utf8,shortname=mixed,fmask=0022,dmask=0022,errors=remount-ro \
      "$EXPORT_DEVICE" "$MOUNT_DIR" >> "$LOG_FILE" 2>&1 || return 1
  fi
  USERDATA_RELEASED=0
  [ -f "$MOUNT_DIR/.plumos-ready" ] || {
    log "mount_refused reason=ready_marker_missing"
    umount "$MOUNT_DIR" >> "$LOG_FILE" 2>&1 || true
    return 1
  }
  prepare_transfer_tree
  if [ -x "$BOOTSTRAP_CONTROL" ]; then
    PLUMOS_ROOT="$PLUMOS_ROOT" PLUMOS_USERDATA_ROOT="$USERDATA_ROOT" \
      "$BOOTSTRAP_CONTROL" validate >> "$LOG_FILE" 2>&1 || return 1
  fi
  if [ -x "$SD2_CONTROL" ]; then
    PLUMOS_ROOT="$PLUMOS_ROOT" PLUMOS_USERDATA_ROOT="$USERDATA_ROOT" \
      "$SD2_CONTROL" start >> "$LOG_FILE" 2>&1 || true
  fi
}

unmount_userdata() {
  resolve_export_device >/dev/null || return 1
  stop_sd2_bindings
  if ! unmount_content_bindings; then
    mount_userdata || true
    return 1
  fi
  sync
  if is_mounted; then
    umount "$MOUNT_DIR" >> "$LOG_FILE" 2>&1 || {
      log "userdata_unmount_failed target=${MOUNT_DIR}"
      mount_userdata || true
      return 1
    }
  fi
  USERDATA_RELEASED=1
  return 0
}

prepare_transfer_tree() {
  [ -d "$MOUNT_DIR" ] || return 0
  mkdir -p \
    "${MOUNT_DIR}/${COMMAND_DIR_NAME}" \
    "${MOUNT_DIR}/${RESULTS_DIR_NAME}" \
    "${MOUNT_DIR}/${PROCESSED_DIR_NAME}" 2>/dev/null || true

  if [ ! -f "${MOUNT_DIR}/${COMMAND_DIR_NAME}/README.TXT" ]; then
    cat > "${MOUNT_DIR}/${COMMAND_DIR_NAME}/README.TXT" <<'EOF' 2>/dev/null || true
plumOS V90S USB command mailbox

To run one command batch on V90S:

1. Copy your shell script to commands/run.sh.
2. Create an empty commands/ALLOW_EXECUTE file.
3. Eject the PLUMOS drive from your PC.
4. Unplug the USB cable.
5. V90S runs commands/run.sh after it remounts p4.
6. Re-enter USB Disk Mode and read RESULT-LATEST.txt plus results/.

The command runs with /mnt/plumos/bin early in PATH and /mnt/plumos as cwd.
This is a diagnostic path, not an interactive shell.
EOF
  fi

  if [ ! -f "${MOUNT_DIR}/${COMMAND_DIR_NAME}/run.sh.example" ]; then
    cat > "${MOUNT_DIR}/${COMMAND_DIR_NAME}/run.sh.example" <<'EOF' 2>/dev/null || true
#!/bin/sh
set -u

echo "plumOS USB command example"
date
uname -a
id
ip addr 2>/dev/null || ifconfig -a 2>/dev/null || true
plumos-network-services status 2>/dev/null || true
plumos-network-control status 2>/dev/null || true
df -h
EOF
  fi
}

make_result_dir() {
  stamp="$(date '+%Y%m%d-%H%M%S' 2>/dev/null || echo unknown)"
  base="${MOUNT_DIR}/${RESULTS_DIR_NAME}/${stamp}"
  candidate="$base"
  n=0
  while ! mkdir "$candidate" 2>/dev/null; do
    n=$((n + 1))
    candidate="${base}-${n}"
    [ "$n" -lt 100 ] || return 1
  done
  printf '%s\n' "$candidate"
}

write_latest_result() {
  result_dir="$1"
  rc="$2"
  timed_out="$3"
  rel_result="${RESULTS_DIR_NAME}/$(basename "$result_dir")"

  {
    printf 'plumOS V90S USB command result\n'
    printf 'time=%s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || true)"
    printf 'exit_code=%s\n' "$rc"
    printf 'timed_out=%s\n' "$timed_out"
    printf 'result_dir=%s\n' "$rel_result"
    printf 'command=%s/command.sh\n' "$rel_result"
    printf 'stdout=%s/stdout.txt\n' "$rel_result"
    printf 'stderr=%s/stderr.txt\n' "$rel_result"
  } > "${MOUNT_DIR}/RESULT-LATEST.txt" 2>/dev/null || true
}

run_command_with_timeout() {
  cmd_copy="$1"
  stdout_file="$2"
  stderr_file="$3"
  timeout_marker="${RUN_DIR}/usb-command-timeout.$$"

  case "$COMMAND_TIMEOUT_SECONDS" in
    ''|*[!0-9]*)
      COMMAND_TIMEOUT_SECONDS=120
      ;;
  esac

  if command -v timeout >/dev/null 2>&1 && [ "$COMMAND_TIMEOUT_SECONDS" -gt 0 ]; then
    (
      cd "$PLUMOS_ROOT" 2>/dev/null || cd /
      export HOME=/root
      export PLUMOS_ROOT PLUMOS_SDCARD_ROOT PATH
      timeout -k 2 "$COMMAND_TIMEOUT_SECONDS" /bin/sh "$cmd_copy"
    ) > "$stdout_file" 2> "$stderr_file"
    rc="$?"
    timed_out=0
    case "$rc" in
      124|137|143)
        timed_out=1
        rc=124
        ;;
    esac
    printf '%s %s\n' "$rc" "$timed_out"
    return 0
  fi

  rm -f "$timeout_marker" 2>/dev/null || true
  (
    cd "$PLUMOS_ROOT" 2>/dev/null || cd /
    export HOME=/root
    export PLUMOS_ROOT PLUMOS_SDCARD_ROOT PATH
    /bin/sh "$cmd_copy"
  ) > "$stdout_file" 2> "$stderr_file" &
  cmd_pid="$!"

  watcher_pid=
  if [ "$COMMAND_TIMEOUT_SECONDS" -gt 0 ]; then
    (
      sleep "$COMMAND_TIMEOUT_SECONDS"
      if kill -0 "$cmd_pid" 2>/dev/null; then
        printf '1\n' > "$timeout_marker" 2>/dev/null || true
        kill "$cmd_pid" 2>/dev/null || true
        sleep 2
        kill -9 "$cmd_pid" 2>/dev/null || true
      fi
    ) &
    watcher_pid="$!"
  fi

  wait "$cmd_pid" 2>/dev/null
  rc="$?"
  if [ -n "$watcher_pid" ]; then
    kill "$watcher_pid" 2>/dev/null || true
  fi

  timed_out=0
  if [ -f "$timeout_marker" ]; then
    timed_out=1
    rc=124
    rm -f "$timeout_marker" 2>/dev/null || true
  fi
  printf '%s %s\n' "$rc" "$timed_out"
}

process_commands() {
  if gadget_bound; then
    log "command_refused reason=gadget_bound"
    return 1
  fi
  mount_userdata || return 1
  prepare_transfer_tree

  command_dir="${MOUNT_DIR}/${COMMAND_DIR_NAME}"
  run_script="${command_dir}/run.sh"
  allow_file="${command_dir}/ALLOW_EXECUTE"
  if [ ! -e "$run_script" ] && [ ! -e "$allow_file" ]; then
    return 0
  fi
  if [ ! -e "$allow_file" ]; then
    log "command_pending_without_allow script=${run_script}"
    return 0
  fi
  if [ ! -f "$run_script" ]; then
    log "command_allow_without_script"
    return 1
  fi
  if [ -L "$run_script" ]; then
    log "command_refused reason=symlink script=${run_script}"
    return 1
  fi

  result_dir="$(make_result_dir)" || return 1
  processed_dir="${MOUNT_DIR}/${PROCESSED_DIR_NAME}/$(basename "$result_dir")"
  mkdir -p "$processed_dir" "$RUN_DIR" 2>/dev/null || true
  cmd_copy="${RUN_DIR}/usb-command-$(basename "$result_dir").sh"

  cp "$run_script" "${result_dir}/command.sh" >> "$LOG_FILE" 2>&1 || return 1
  cp "$run_script" "$cmd_copy" >> "$LOG_FILE" 2>&1 || return 1
  chmod 700 "$cmd_copy" 2>/dev/null || true
  cp "$run_script" "${processed_dir}/run.sh" >> "$LOG_FILE" 2>&1 || true
  rm -f "$allow_file" "$run_script" 2>/dev/null || true
  sync

  {
    printf 'time=%s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || true)"
    printf 'timeout_seconds=%s\n' "$COMMAND_TIMEOUT_SECONDS"
    printf 'cwd=%s\n' "$PLUMOS_ROOT"
    printf 'PATH=%s\n' "$PATH"
    printf 'PLUMOS_ROOT=%s\n' "$PLUMOS_ROOT"
    printf 'PLUMOS_SDCARD_ROOT=%s\n' "$PLUMOS_SDCARD_ROOT"
    printf 'uname=%s\n' "$(uname -a 2>/dev/null || true)"
  } > "${result_dir}/env.txt" 2>/dev/null || true

  log "command_start result=$(basename "$result_dir") timeout=${COMMAND_TIMEOUT_SECONDS}"
  set -- $(run_command_with_timeout "$cmd_copy" "${result_dir}/stdout.txt" "${result_dir}/stderr.txt")
  rc="$1"
  timed_out="$2"
  printf '%s\n' "$rc" > "${result_dir}/exit_code.txt" 2>/dev/null || true
  printf '%s\n' "$timed_out" > "${result_dir}/timed_out.txt" 2>/dev/null || true
  write_latest_result "$result_dir" "$rc" "$timed_out"
  rm -f "$cmd_copy" 2>/dev/null || true
  sync
  log "command_done result=$(basename "$result_dir") rc=${rc} timed_out=${timed_out}"
  return 0
}

pause_network_services() {
  [ -x "$NETWORK_SERVICES" ] || return 0
  if [ -f "$SERVICES_CONF" ]; then
    cp "$SERVICES_CONF" "$SERVICES_BACKUP" >> "$LOG_FILE" 2>&1 || return 1
  else
    : > "$SERVICES_BACKUP"
  fi
  for service in ftp sftp samba; do
    PLUMOS_ROOT="$PLUMOS_ROOT" PLUMOS_SDCARD_ROOT="$PLUMOS_SDCARD_ROOT" \
      "$NETWORK_SERVICES" stop "$service" >> "$LOG_FILE" 2>&1 || true
  done
  if [ -s "$SERVICES_BACKUP" ]; then
    cp "$SERVICES_BACKUP" "$SERVICES_CONF" >> "$LOG_FILE" 2>&1 || return 1
  fi
  SERVICES_RESTORE=1
  : > "$SERVICES_RESTORE_FILE"
  log "network_storage_services_paused"
}

service_was_enabled() {
  key="$1"
  value="$(sed -n "s/^${key}=//p" "$SERVICES_CONF" 2>/dev/null | tail -n 1)"
  [ "$value" = 1 ] || [ "$value" = true ] || [ "$value" = on ]
}

restore_network_services() {
  [ "$SERVICES_RESTORE" -eq 1 ] || [ -e "$SERVICES_RESTORE_FILE" ] || return 0
  SERVICES_RESTORE=0
  rm -f "$SERVICES_RESTORE_FILE" 2>/dev/null || true
  [ -x "$NETWORK_SERVICES" ] || return 0
  for pair in ftp:ftp_enabled sftp:sftp_enabled samba:samba_enabled; do
    service="${pair%%:*}"
    key="${pair#*:}"
    service_was_enabled "$key" || continue
    PLUMOS_ROOT="$PLUMOS_ROOT" PLUMOS_SDCARD_ROOT="$PLUMOS_SDCARD_ROOT" \
      "$NETWORK_SERVICES" start "$service" >> "$LOG_FILE" 2>&1 || true
  done
  log "network_storage_services_restored"
}

teardown_gadget() {
  if [ -d "$GADGET_DIR" ]; then
    if [ -w "${GADGET_DIR}/UDC" ]; then
      printf '\n' > "${GADGET_DIR}/UDC" 2>/dev/null || true
    fi
    rm -f "${GADGET_DIR}/configs/c.1/${FUNCTION_NAME}" 2>/dev/null || true
    rmdir "${GADGET_DIR}/functions/${FUNCTION_NAME}" 2>/dev/null || true
    rmdir "${GADGET_DIR}/configs/c.1/strings/0x409" 2>/dev/null || true
    rmdir "${GADGET_DIR}/configs/c.1" 2>/dev/null || true
    rmdir "${GADGET_DIR}/strings/0x409" 2>/dev/null || true
    rmdir "${GADGET_DIR}/functions" 2>/dev/null || true
    rmdir "${GADGET_DIR}/configs" 2>/dev/null || true
    rmdir "$GADGET_DIR" 2>/dev/null || true
  fi
}

stop_adb_for_transfer() {
  [ -x "$ADB_CONTROL" ] || return 0
  if PLUMOS_ROOT="$PLUMOS_ROOT" PLUMOS_SDCARD_ROOT="$PLUMOS_SDCARD_ROOT" \
      "$ADB_CONTROL" status 2>/dev/null | grep -q '^running=1$'; then
    ADB_RESTORE=1
    : > "$ADB_RESTORE_FILE"
    log "adb_pause_requested"
    PLUMOS_ROOT="$PLUMOS_ROOT" PLUMOS_SDCARD_ROOT="$PLUMOS_SDCARD_ROOT" \
      "$ADB_CONTROL" stop >> "$LOG_FILE" 2>&1 || return 1
  fi
}

restore_adb() {
  [ "$ADB_RESTORE" -eq 1 ] || [ -e "$ADB_RESTORE_FILE" ] || return 0
  ADB_RESTORE=0
  rm -f "$ADB_RESTORE_FILE" 2>/dev/null || true
  [ -x "$ADB_CONTROL" ] || return 0
  log "adb_restore_requested"
  PLUMOS_ROOT="$PLUMOS_ROOT" PLUMOS_SDCARD_ROOT="$PLUMOS_SDCARD_ROOT" \
    "$ADB_CONTROL" start >> "$LOG_FILE" 2>&1 || true
}

setup_gadget() {
  udc="$(udc_name)" || {
    log "udc_missing"
    return 1
  }

  teardown_gadget
  mkdir -p \
    "${GADGET_DIR}/strings/0x409" \
    "${GADGET_DIR}/configs/c.1/strings/0x409" \
    "${GADGET_DIR}/functions/${FUNCTION_NAME}" || return 1

  printf '0x1d6b\n' > "${GADGET_DIR}/idVendor"
  printf '0x0104\n' > "${GADGET_DIR}/idProduct"
  printf '0x0200\n' > "${GADGET_DIR}/bcdUSB"
  printf '0x0100\n' > "${GADGET_DIR}/bcdDevice"
  printf 'plumos-v90s-%s\n' "$(cat /proc/sys/kernel/random/boot_id 2>/dev/null | cut -c1-8)" \
    > "${GADGET_DIR}/strings/0x409/serialnumber"
  printf 'plumOS\n' > "${GADGET_DIR}/strings/0x409/manufacturer"
  printf 'plumOS V90S PLUMOS Volume\n' > "${GADGET_DIR}/strings/0x409/product"
  printf 'PLUMOS Volume\n' > "${GADGET_DIR}/configs/c.1/strings/0x409/configuration"
  printf '120\n' > "${GADGET_DIR}/configs/c.1/MaxPower"

  printf '1\n' > "${GADGET_DIR}/functions/${FUNCTION_NAME}/lun.0/removable"
  printf '0\n' > "${GADGET_DIR}/functions/${FUNCTION_NAME}/lun.0/ro"
  printf '0\n' > "${GADGET_DIR}/functions/${FUNCTION_NAME}/lun.0/cdrom"
  printf '0\n' > "${GADGET_DIR}/functions/${FUNCTION_NAME}/lun.0/nofua" 2>/dev/null || true
  printf 'plumOS PLUMOS Volume\n' \
    > "${GADGET_DIR}/functions/${FUNCTION_NAME}/lun.0/inquiry_string" 2>/dev/null || true
  printf '%s\n' "$EXPORT_DEVICE" > "${GADGET_DIR}/functions/${FUNCTION_NAME}/lun.0/file"
  ln -s "${GADGET_DIR}/functions/${FUNCTION_NAME}" "${GADGET_DIR}/configs/c.1/${FUNCTION_NAME}"
  printf '%s\n' "$udc" > "${GADGET_DIR}/UDC"
}

wait_for_disconnect() {
  deadline=0
  connected=0
  if [ "$CONNECT_TIMEOUT_SECONDS" -gt 0 ] 2>/dev/null; then
    deadline=$(( $(date +%s 2>/dev/null || echo 0) + CONNECT_TIMEOUT_SECONDS ))
  fi

  while :; do
    state="$(udc_state)"
    case "$state" in
      configured|addressed|powered)
        connected=1
        ;;
      "not attached"|"")
        if [ "$connected" -eq 1 ]; then
          return 0
        fi
        ;;
    esac

    if [ "$connected" -eq 0 ] && [ "$deadline" -gt 0 ]; then
      now="$(date +%s 2>/dev/null || echo 0)"
      if [ "$now" -ge "$deadline" ]; then
        log "connect_timeout state=${state}"
        return 1
      fi
    fi
    sleep 1
  done
}

enter_mode() {
  log "enter_requested target=${MOUNT_DIR}"
  ensure_configfs || return 1
  resolve_export_device >/dev/null || return 1
  pause_network_services || return 1
  if ! stop_adb_for_transfer; then
    restore_network_services
    restore_adb
    return 1
  fi
  if ! unmount_userdata; then
    restore_network_services
    restore_adb
    return 1
  fi
  if ! setup_gadget; then
    mount_userdata || true
    restore_network_services
    restore_adb
    return 1
  fi
  ACTIVE=1
  log "gadget_bound udc=$(cat "${GADGET_DIR}/UDC" 2>/dev/null || true) state=$(udc_state)"

  if wait_for_disconnect; then
    log "disconnect_detected"
    teardown_gadget
    ACTIVE=0
    if ! mount_userdata; then
      restore_network_services
      restore_adb
      return 1
    fi
    process_commands || true
    restore_network_services
    restore_adb
    log "leave_complete mounted=${MOUNT_DIR}"
    return 0
  fi

  teardown_gadget
  ACTIVE=0
  mount_userdata || true
  restore_network_services
  restore_adb
  return 1
}

leave_mode() {
  log "leave_requested"
  teardown_gadget
  mount_userdata || return 1
  process_commands || true
  restore_network_services
  restore_adb
}

status_mode() {
  resolve_export_device >/dev/null 2>&1 || true
  printf 'export_device=%s\n' "$EXPORT_DEVICE"
  printf 'mount_dir=%s\n' "$MOUNT_DIR"
  printf 'volume=PLUMOS\n'
  printf 'mounted=%s\n' "$( is_mounted && echo 1 || echo 0 )"
  printf 'gadget_bound=%s\n' "$( gadget_bound && echo 1 || echo 0 )"
  printf 'udc_state=%s\n' "$(udc_state)"
  if is_mounted; then
    printf 'command_script=%s\n' "$( [ -f "${MOUNT_DIR}/${COMMAND_DIR_NAME}/run.sh" ] && echo 1 || echo 0 )"
    printf 'command_armed=%s\n' "$( [ -e "${MOUNT_DIR}/${COMMAND_DIR_NAME}/ALLOW_EXECUTE" ] && echo 1 || echo 0 )"
    printf 'latest_result=%s\n' "$( [ -f "${MOUNT_DIR}/RESULT-LATEST.txt" ] && echo 1 || echo 0 )"
  fi
  if [ -d "$GADGET_DIR" ] && [ -r "${GADGET_DIR}/UDC" ]; then
    printf 'udc=%s\n' "$(cat "${GADGET_DIR}/UDC" 2>/dev/null || true)"
  fi
}

case "${1:-status}" in
  enter)
    enter_mode
    ;;
  leave)
    leave_mode
    ;;
  mount)
    mount_userdata
    ;;
  unmount)
    unmount_userdata
    ;;
  process-commands)
    process_commands
    ;;
  status)
    status_mode
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    printf 'error: unknown command: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac
