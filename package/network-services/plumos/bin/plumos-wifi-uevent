#!/bin/sh
set -u

PLUMOS_ROOT="${PLUMOS_ROOT:-/mnt/plumos}"
RECOVERY_CONTROL="${PLUMOS_ROOT}/bin/plumos-wifi-recovery"

[ "${ACTION:-}" = add ] || exit 0
[ "${SUBSYSTEM:-}" = net ] || exit 0

iface="${INTERFACE:-}"
if [ -z "$iface" ] && [ -n "${DEVPATH:-}" ]; then
  iface="${DEVPATH##*/}"
fi
case "$iface" in
  wlan*|mlan*|p2p*) ;;
  *) exit 0 ;;
esac

[ -x "$RECOVERY_CONTROL" ] || exit 0
exec "$RECOVERY_CONTROL" recover >/dev/null 2>&1
