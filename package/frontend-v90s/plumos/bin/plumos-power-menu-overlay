#!/bin/sh
set -u

PLUMOS_ROOT="${PLUMOS_ROOT:-/mnt/plumos}"
RUNTIME_ROOT="${PLUMOS_RUNTIME_ROOT:-/run/plumos}"
LOG_DIR="$PLUMOS_ROOT/Logs"
LOG_FILE="${PLUMOS_POWER_MENU_OVERLAY_LOG:-$LOG_DIR/power-menu-overlay.log}"
MENU="${PLUMOS_POWER_MENU_OVERLAY_UI:-$PLUMOS_ROOT/bin/plumos-controller-ui-v90s}"
MENU_ARGS="${PLUMOS_POWER_MENU_OVERLAY_UI_ARGS:---power-overlay}"
SAFE_SHUTDOWN="$PLUMOS_ROOT/bin/plumos-safe-shutdown"
LOCK_DIR="$RUNTIME_ROOT/power-menu-overlay.lock"
SELECTION_FILE="$RUNTIME_ROOT/power-menu-overlay.$$.selection"
RESTORE_RAW="$RUNTIME_ROOT/power-menu-overlay.$$.restore.raw"
HOLD_RAW="$RUNTIME_ROOT/power-menu-overlay.$$.hold.raw"
PAUSED_PIDS=""
HOLD_PID=""
STRIDE=0
YRES=0
VYRES=0
YOFFSET=0
PAGES=1
SNAPSHOT_READY=0
TERMINAL_ACTION=0

mkdir -p "$LOG_DIR" "$RUNTIME_ROOT" 2>/dev/null || true

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo unknown-time)" "$*" \
    >>"$LOG_FILE" 2>/dev/null || true
}

is_uint() {
  case "${1:-}" in
    ""|*[!0-9]*) return 1 ;;
  esac
  return 0
}

read_geometry() {
  virtual="$(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null || true)"
  pan="$(cat /sys/class/graphics/fb0/pan 2>/dev/null || true)"
  stride="$(cat /sys/class/graphics/fb0/stride 2>/dev/null || true)"
  modes="$(cat /sys/class/graphics/fb0/modes 2>/dev/null || true)"
  case "$virtual" in
    *,*) vyres="${virtual#*,}" ;;
    *) return 1 ;;
  esac
  yres="$(printf '%s\n' "$modes" | sed -n 's/.*x\([0-9][0-9]*\).*/\1/p' | head -1)"
  if ! is_uint "$yres" || [ "$yres" -le 0 ]; then
    yres=$((vyres / 2))
  fi
  case "$pan" in
    *,*) yoffset="${pan#*,}" ;;
    *) yoffset=0 ;;
  esac
  is_uint "$stride" || return 1
  is_uint "$yres" || return 1
  is_uint "$vyres" || return 1
  is_uint "$yoffset" || yoffset=0
  [ "$stride" -gt 0 ] || return 1
  [ "$yres" -gt 0 ] || return 1
  [ "$vyres" -ge "$yres" ] || return 1
  [ $((yoffset + yres)) -le "$vyres" ] || return 1
  STRIDE="$stride"
  YRES="$yres"
  VYRES="$vyres"
  YOFFSET="$yoffset"
  PAGES=$((vyres / yres))
  [ "$PAGES" -gt 0 ] || PAGES=1
}

add_paused_pid() {
  pid="$1"
  case "$pid" in
    ""|*[!0-9]*) return ;;
  esac
  [ "$pid" = "$$" ] && return
  [ "$pid" = "${PPID:-}" ] && return
  case " $PAUSED_PIDS " in
    *" $pid "*) return ;;
  esac
  if kill -0 "$pid" 2>/dev/null && kill -STOP "$pid" 2>/dev/null; then
    PAUSED_PIDS="$PAUSED_PIDS $pid"
  fi
}

pause_display_owners() {
  for fd in /proc/[0-9]*/fd/*; do
    target="$(readlink "$fd" 2>/dev/null || true)"
    case "$target" in
      /dev/fb0|/dev/dri/*|/dev/mali*|/dev/pvr*|/dev/disp)
        ;;
      *)
        continue
        ;;
    esac
    pid="${fd#/proc/}"
    pid="${pid%%/*}"
    add_paused_pid "$pid"
  done
  log "pause pids=$(printf '%s' "$PAUSED_PIDS" | sed 's/^ *//;s/ *$//')"
}

resume_display_owners() {
  [ -n "$PAUSED_PIDS" ] || return 0
  log "resume pids=$(printf '%s' "$PAUSED_PIDS" | sed 's/^ *//;s/ *$//')"
  kill -CONT $PAUSED_PIDS 2>/dev/null || true
  PAUSED_PIDS=""
}

snapshot_visible_page() {
  target="$1"
  read_geometry || return 1
  if dd if=/dev/fb0 of="$target" bs="$STRIDE" skip="$YOFFSET" \
      count="$YRES" 2>>"$LOG_FILE"; then
    log "snapshot path=$target yres=$YRES vyres=$VYRES yoffset=$YOFFSET stride=$STRIDE"
    return 0
  fi
  return 1
}

write_page_to_all_buffers() {
  source="$1"
  [ -r "$source" ] || return 1
  page=0
  while [ "$page" -lt "$PAGES" ]; do
    dd if="$source" of=/dev/fb0 bs="$STRIDE" seek=$((page * YRES)) \
      count="$YRES" conv=notrunc 2>>"$LOG_FILE" || return 1
    page=$((page + 1))
  done
  if [ -w /sys/class/graphics/fb0/pan ]; then
    printf '0,%s\n' "$YOFFSET" >/sys/class/graphics/fb0/pan 2>>"$LOG_FILE" || true
  fi
}

restore_snapshot() {
  [ "$SNAPSHOT_READY" = 1 ] || return 0
  write_page_to_all_buffers "$RESTORE_RAW" || true
  SNAPSHOT_READY=0
}

start_frame_hold() {
  snapshot_visible_page "$HOLD_RAW" || return 1
  write_page_to_all_buffers "$HOLD_RAW" || true
  (
    trap 'exit 0' INT TERM
    while :; do
      write_page_to_all_buffers "$HOLD_RAW" || true
      if [ -x "$PLUMOS_ROOT/bin/usleep" ]; then
        "$PLUMOS_ROOT/bin/usleep" 80000 2>/dev/null || true
      elif command -v usleep >/dev/null 2>&1; then
        usleep 80000 2>/dev/null || true
      else
        sleep 1
      fi
    done
  ) &
  HOLD_PID=$!
  log "hold start pid=$HOLD_PID"
}

stop_frame_hold() {
  [ -n "$HOLD_PID" ] || return 0
  kill -TERM "$HOLD_PID" 2>/dev/null || true
  wait "$HOLD_PID" 2>/dev/null || true
  HOLD_PID=""
}

read_selection() {
  sed -n 's/^action=//p' "$SELECTION_FILE" 2>/dev/null | head -1
}

run_power_action() {
  action="$1"
  case "$action" in
    sleep)
      "$SAFE_SHUTDOWN" --sleep --sleep-backend mem --no-poweroff \
        --no-hold-resume >>"$LOG_DIR/frontend-power-action.log" 2>&1
      ;;
    reboot)
      "$SAFE_SHUTDOWN" --reboot --no-hold-resume \
        >>"$LOG_DIR/frontend-power-action.log" 2>&1
      ;;
    shutdown)
      "$SAFE_SHUTDOWN" --shutdown --poweroff --power-backend auto \
        --no-hold-resume >>"$LOG_DIR/frontend-power-action.log" 2>&1
      ;;
    *) return 2 ;;
  esac
}

cleanup() {
  stop_frame_hold
  if [ "$TERMINAL_ACTION" = 0 ]; then
    restore_snapshot
    resume_display_owners
  fi
  rm -f "$SELECTION_FILE" "$RESTORE_RAW" "$HOLD_RAW" 2>/dev/null || true
  rmdir "$LOCK_DIR" 2>/dev/null || true
}

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  log "skip reason=already-open"
  exit 0
fi
trap 'exit 130' INT
trap 'exit 143' TERM
trap cleanup EXIT

[ -x "$MENU" ] || {
  log "error menu-missing path=$MENU"
  exit 127
}
[ -x "$SAFE_SHUTDOWN" ] || {
  log "error safe-shutdown-missing path=$SAFE_SHUTDOWN"
  exit 127
}

rm -f "$SELECTION_FILE" 2>/dev/null || true
if snapshot_visible_page "$RESTORE_RAW"; then
  SNAPSHOT_READY=1
fi
pause_display_owners
log "menu begin backend=$MENU args=$MENU_ARGS"
PLUMOS_FRONTEND_MODE=manual \
PLUMOS_POWER_MENU_SELECTION="$SELECTION_FILE" \
PLUMOS_POWER_INPUT_EVENT="${PLUMOS_POWER_INPUT_EVENT:-/dev/input/event1}" \
  "$MENU" $MENU_ARGS
menu_rc=$?
selection="$(read_selection)"
log "menu end rc=$menu_rc selection=${selection:-cancel}"

case "$selection" in
  sleep)
    run_power_action sleep
    action_rc=$?
    restore_snapshot
    resume_display_owners
    exit "$action_rc"
    ;;
  reboot|shutdown)
    start_frame_hold || true
    resume_display_owners
    TERMINAL_ACTION=1
    run_power_action "$selection"
    action_rc=$?
    TERMINAL_ACTION=0
    stop_frame_hold
    restore_snapshot
    resume_display_owners
    exit "$action_rc"
    ;;
  cancel|"")
    restore_snapshot
    resume_display_owners
    exit "$menu_rc"
    ;;
  *)
    log "selection ignored value=$selection"
    restore_snapshot
    resume_display_owners
    exit "$menu_rc"
    ;;
esac
