diff --git a/Makefile b/Makefile
index d16a23d..4cb3d3b 100644
--- a/Makefile
+++ b/Makefile
@@ -81,6 +81,39 @@ CXXFLAGS += -DAUTOSCALE_DPI=1
 CXXFLAGS += -DPPU_X=3
 CXXFLAGS += -DPPU_Y=3
 CXXFLAGS += -DSCREEN_BPP=32
+
+# POWKIDDY V90S / plumOS
+else ifneq (,$(findstring v90s,$(PLATFORM)))
+SDCARD_ROOT := /mnt/plumos
+NEXTUI_SYSTEM_PATH := $(SDCARD_ROOT)/apps/nextcommander
+
+CXXFLAGS += -O2 -pipe -fomit-frame-pointer
+CXXFLAGS += -DPLUMOS_V90S
+CXXFLAGS += -DPATH_DEFAULT=\"$(SDCARD_ROOT)\"
+CXXFLAGS += -DPATH_DEFAULT_RIGHT=\"$(SDCARD_ROOT)/roms\"
+CXXFLAGS += -DFILE_SYSTEM=\"$(SDCARD_ROOT)\"
+
+# Buttons from the V90S SDL2 joystick path. Keep the same logical mapping as
+# the A30 NextCommander port: A open, B parent, X operation, Y system.
+CXXFLAGS += -DCMDR_KEY_UP=SDLK_UP
+CXXFLAGS += -DCMDR_KEY_RIGHT=SDLK_RIGHT
+CXXFLAGS += -DCMDR_KEY_DOWN=SDLK_DOWN
+CXXFLAGS += -DCMDR_KEY_LEFT=SDLK_LEFT
+CXXFLAGS += -DCMDR_KEY_OPEN=0
+CXXFLAGS += -DCMDR_KEY_PARENT=1
+CXXFLAGS += -DCMDR_KEY_OPERATION=2
+CXXFLAGS += -DCMDR_KEY_SYSTEM=3
+CXXFLAGS += -DCMDR_KEY_PAGEUP=4
+CXXFLAGS += -DCMDR_KEY_PAGEDOWN=5
+CXXFLAGS += -DCMDR_KEY_SELECT=8
+CXXFLAGS += -DCMDR_KEY_TRANSFER=9
+CXXFLAGS += -DCMDR_KEY_MENU=10
+
+CXXFLAGS += -DAUTOSCALE=0
+CXXFLAGS += -DAUTOSCALE_DPI=0
+CXXFLAGS += -DPPU_X=2
+CXXFLAGS += -DPPU_Y=2
+CXXFLAGS += -DSCREEN_BPP=32
 endif
 
 SDL := SDL2
@@ -127,7 +160,7 @@ all: $(EXECUTABLE)
 $(EXECUTABLE): $(addprefix $(OUTDIR)/,$(OBJS))
 	$(SUM) "  LINK    $@"
 	$(SUM) "  LINK    $(LINKFLAGS)"
-	$(CMD)$(CXX) $(LINKFLAGS) -o $@ $^
+	$(CMD)$(CXX) -o $@ $^ $(LINKFLAGS)
 
 $(OUTDIR)/%.o: src/%.cpp
 	@mkdir -p $(@D)
