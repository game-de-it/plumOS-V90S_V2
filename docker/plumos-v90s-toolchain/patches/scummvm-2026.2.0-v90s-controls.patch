+++ b/backends/events/sdl/sdl-common-events.cpp
@@ -216,6 +216,40 @@ bool SdlEventSource::handleJoyHatMotion(SDL_Event &ev, Common::Event &event) {
 	return false;
 }
 
+#if defined(PLUMOS_V90S)
+bool SdlEventSource::pollV90sHatMouse(Common::Event &event) {
+	if (_lastHatPosition == SDL_HAT_CENTERED || !_graphicsManager)
+		return false;
+
+	const uint32 now = SDL_GetTicks();
+	if (now - _v90sLastHatMouseTime < 16)
+		return false;
+	_v90sLastHatMouseTime = now;
+
+	const int xMax = _graphicsManager->getWindowWidth() - 1;
+	const int yMax = _graphicsManager->getWindowHeight() - 1;
+	if (xMax < 1 || yMax < 1)
+		return false;
+
+	if (!_v90sHatMouseStarted) {
+		_mouseX = xMax / 2;
+		_mouseY = yMax / 2;
+		_v90sHatMouseStarted = true;
+	}
+
+	const int dx = ((_lastHatPosition & SDL_HAT_RIGHT) ? 1 : 0) -
+	               ((_lastHatPosition & SDL_HAT_LEFT) ? 1 : 0);
+	const int dy = ((_lastHatPosition & SDL_HAT_DOWN) ? 1 : 0) -
+	               ((_lastHatPosition & SDL_HAT_UP) ? 1 : 0);
+	const int speed = 8;
+	const int x = CLIP(_mouseX + dx * speed, 0, xMax);
+	const int y = CLIP(_mouseY + dy * speed, 0, yMax);
+
+	event.type = Common::EVENT_MOUSEMOVE;
+	return processMouseEvent(event, x, y, x - _mouseX, y - _mouseY);
+}
+#endif
