diff --git a/src/gui/sdlmain.cpp b/src/gui/sdlmain.cpp
index 95416772..1381040c 100644
--- a/src/gui/sdlmain.cpp
+++ b/src/gui/sdlmain.cpp
@@ -2542,6 +2542,26 @@ static void update_frame_gl([[maybe_unused]] const uint16_t *changedLines)
 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
 static void update_frame_texture([[maybe_unused]] const uint16_t *changedLines)
 {
+#ifdef PLUMOS_V90S
+	/*
+	 * The V90S PowerVR scanout consumes the framebuffer alpha byte. DOSBox's
+	 * RGB-only palette conversion leaves that byte at zero even when SDL chose
+	 * an ARGB texture, so the LCD treats otherwise valid frames as transparent.
+	 */
+	auto *surface = sdl.texture.input_surface;
+	if (surface && surface->format && surface->format->BytesPerPixel == 4 &&
+	    surface->format->Amask != 0) {
+		const auto alpha_mask = surface->format->Amask;
+		for (int y = 0; y < surface->h; ++y) {
+			auto *row = reinterpret_cast<uint32_t *>(
+			        static_cast<uint8_t *>(surface->pixels) + y * surface->pitch);
+			for (int x = 0; x < surface->w; ++x) {
+				row[x] |= alpha_mask;
+			}
+		}
+	}
+#endif
+
 	SDL_UpdateTexture(sdl.texture.texture,
 	                  nullptr, // update entire texture
 	                  sdl.texture.input_surface->pixels,
